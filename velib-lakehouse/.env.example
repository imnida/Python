# =============================================================================
# Vélib Lakehouse — Variables d'environnement
# Copier ce fichier en .env et remplir les valeurs
# =============================================================================

# --- PostgreSQL (Dagster metadata) ---
DAGSTER_POSTGRES_USER=dagster
DAGSTER_POSTGRES_PASSWORD=changeme
DAGSTER_POSTGRES_DB=dagster

# --- MinIO / S3 ---
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=changeme_min16chars
BUCKET=velib-lakehouse

# Chemin de stockage MinIO sur le RPi (SSD externe recommandé)
# Laisser vide pour utiliser ./data/minio (SD card)
MINIO_DATA_PATH=/mnt/ssd/minio

# --- FastAPI ---
API_KEY=changeme_api_key
DOCS_USER=admin
DOCS_PASSWORD=changeme_docs_password

# --- Alerting (optionnel — Resend API) ---
RESEND_API_KEY=
ALERT_EMAIL=

# --- Images Docker (buildées en CI et poussées sur GHCR) ---
# Format: ghcr.io/<owner>/<repo>/dagster:latest
# Remplacer par votre namespace GHCR ou laisser vide pour builder localement
DAGSTER_IMAGE=ghcr.io/julcrm/velib-lakehouse/dagster:latest
API_IMAGE=ghcr.io/julcrm/velib-lakehouse/api:latest
