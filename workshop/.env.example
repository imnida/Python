# Copy this file to .env and fill in your values.
# Never commit .env to source control.

# Azure AI Foundry project endpoint
# Format: https://<hub>.services.ai.azure.com/api/projects/<project-name>
FOUNDRY_PROJECT_ENDPOINT=https://<yourproject>.services.ai.azure.com/api/projects/<project-name>

# Model deployment names (must be deployed in your Foundry project)
FOUNDRY_MODEL=gpt-5.5
AZURE_OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# LAB05 AG-UI control tower
AGUI_SERVER_URL=http://127.0.0.1:5100/
AG_UI_API_KEY=zava-control-tower-demo-key
